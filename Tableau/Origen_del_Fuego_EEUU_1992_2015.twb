    <column datatype='integer' name="[N incendios]" role='measure' type='quantitative' />
    <column datatype='real' name="[Acres]" role='measure' type='quantitative' />
    <column datatype='real' name="[Hectareas]" role='measure' type='quantitative' />
    <column datatype='integer' name="[N grandes incendios]" role='measure' type='quantitative' />
    <column caption="Acres promedio por incendio" datatype='real' default-format="n#,##0.00" name='[AcresPromedio]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([Acres]) / SUM([N incendios])" scope-isolation='false' />
    </column>
    <column caption="% de grandes incendios" datatype='real' default-format="p0.00%" name='[PctGrandes]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([N grandes incendios]) / SUM([N incendios])" scope-isolation='false' />
    </column>
    <column caption="% de eventos sobre el total" datatype='real' default-format="p0.00%" name='[PctEventos]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([N incendios]) / TOTAL(SUM([N incendios]))" scope-isolation='false' />
    </column>
    <column caption="% de superficie sobre el total" datatype='real' default-format="p0.00%" name='[PctAcres]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="SUM([Acres]) / TOTAL(SUM([Acres]))" scope-isolation='false' />
    </column>
    <column caption="Indice de severidad relativa" datatype='real' default-format="n#,##0.00" name='[SeveridadRelativa]' role='measure' type='quantitative'>
      <calculation class='tableau' formula="(SUM([Acres]) / SUM([N incendios])) / TOTAL(SUM([Acres]) / SUM([N incendios]))" scope-isolation='false' />
    </column>
    <column caption="Origen del fuego" datatype='string' name='[OrigenFuego]' role='dimension' type='nominal'>
      <calculation class='tableau' formula="[Origen del fuego]" scope-isolation='false' />
    </column>
    <column-instance column='[OrigenFuego]' derivation='None' name="[none:OrigenFuego:nk]" pivot='key' type='nominal' />
    <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
    <style>
      <style-rule element='mark'>
        <encoding attr='color' field="[none:OrigenFuego:nk]" type='palette'>
          <map to='#f25c05'>
            <bucket>&quot;Antropico&quot;</bucket>
          </map>
          <map to='#4fa3f7'>
            <bucket>&quot;Natural&quot;</bucket>
          </map>
          <map to='#8c8c8c'>
            <bucket>&quot;No determinado&quot;</bucket>
          </map>
        </encoding>
      </style-rule>
    </style>
