  <worksheets>
    <worksheet name="Eventos por origen">
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#4A3B33' fontsize='11'>Numero de incendios segun origen del fuego</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Hechos incendios" name='federated.hechosincendios' />
          </datasources>
          <datasource-dependencies datasource='federated.hechosincendios'>
            <column datatype='integer' name="[Anio]" role='dimension' type='ordinal' />
            <column datatype='string' name="[Region censal]" role='dimension' type='nominal' />
            <column datatype='integer' name="[N incendios]" role='measure' type='quantitative' />
            <column-instance column="[Anio]" derivation='None' name="[none:Anio:ok]" pivot='key' type='ordinal' />
            <column-instance column="[Region censal]" derivation='None' name="[none:Region censal:nk]" pivot='key' type='nominal' />
            <column-instance column="[N incendios]" derivation='Sum' name="[sum:N incendios:qk]" pivot='key' type='quantitative' />
            <column caption="Origen del fuego" datatype='string' name='[OrigenFuego]' role='dimension' type='nominal'>
              <calculation class='tableau' formula="[Origen del fuego]" scope-isolation='false' />
            </column>
            <column-instance column='[OrigenFuego]' derivation='None' name="[none:OrigenFuego:nk]" pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.hechosincendios].[none:Anio:ok]" filter-group='100'>
            <groupfilter function='level-members' level="[none:Anio:ok]" user:ui-enumeration='all' user:ui-marker='enumerate' />
